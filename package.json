{
  "name": "nodejs-interactive-textbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Интерактивный учебник: Middle Node.js Backend",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:labs": "tsx tools/gen-labs.ts",
    "e2e": "node tools/e2e/run.mjs",
    "lint:content": "tsx tools/lint-content.ts",
    "check:size": "node tools/check-size.mjs dist",
    "record:traces": "tsx tools/record-traces.ts",
    "bank": "tsx tools/build-question-bank.ts",
    "gen:labs:m03": "tsx tools/gen-labs-m03.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electric-sql/pglite": "^0.6.0",
    "codemirror": "^6.0.2",
    "marked": "^18.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.14.1",
    "@nestjs/common": "^12.6.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/platform-express": "^12.6.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "puppeteer-core": "^25.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
